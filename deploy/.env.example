# Copied to deploy/.env (gitignored) for docker compose --env-file/env_file.
CADDY_DOMAIN=portal.zerostrike.ai
CADDY_EMAIL=admin@zerostrike.ai

MONGODB_DB_NAME=zerostrike
CORS_ORIGINS=["https://portal.zerostrike.ai"]
CLONE_WORKDIR_PATH=/tmp/zs-clones

# Server-side (cloud) scan tuning. These three are what a large repository actually depends on,
# so read the note before changing one -- see docs/OBSERVABILITY_SCAN_AND_AI.md#large-repos.
#
# SCAN_TIMEOUT_SECONDS bounds the clone and the scan SEPARATELY, and it is the real ceiling on
# repo size: exceed it and the scan fails with a message saying so. 900s is fine for a normal
# service and too small for a monorepo (microsoft/vscode alone needs ~525s of scan time on a
# developer laptop, and a throttled container is slower). Raise it before blaming the scanner.
SCAN_TIMEOUT_SECONDS=900
#
# SCANNER_MAX_WORKERS is a MEMORY setting, not a speed one: the SAST stage holds a tree-sitter
# parser and a whole file's AST per worker, so this is what keeps a large repo inside the
# container's memory limit. Needs scanner >= v0.34.0 to have any effect at all -- earlier builds
# ignored it and always used runtime.NumCPU(), which is how a many-core container OOM-killed
# itself on a big repository and left the scan looking like a crashed worker.
SCANNER_MAX_WORKERS=2
#
# Each concurrent cloud scan is its own clone + scanner subprocess in the backend container.
# Multiply by the per-scan memory above before raising this.
MAX_CONCURRENT_CLOUD_SCANS=2

NEXT_PUBLIC_API_BASE_URL=/api/v1
# Shown in the UI's local/CI setup instructions as `--server <origin>` (no /api/v1 suffix) — the
# backend's origin, which happens to equal the portal's public origin here since Caddy proxies
# both from one domain.
NEXT_PUBLIC_SCANNER_SERVER_ORIGIN=https://portal.zerostrike.ai

# Pin the CGO-enabled scanner build baked into the backend image (see backend/Dockerfile).
# Keep this in sync with the ARG default in backend/Dockerfile and the SCANNER_REF
# fallback in deploy/docker-compose.yml -- all three must match.
SCANNER_REF=v0.34.0

# Secrets (MONGODB_URI, JWT_SECRET) are NOT set here — see deploy/secrets/*.txt.example
