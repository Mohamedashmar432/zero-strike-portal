MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=zerostrike
JWT_SECRET=dev-secret-change-me
CORS_ORIGINS=["http://localhost:3000"]

# Server-side (cloud) scan execution — the scanner runs as a subprocess, no Docker needed.
# Local Windows: point at the prebuilt binary in the sibling scanner repo, e.g.
#   SCANNER_BINARY_PATH=C:\Users\<you>\playground\zero-strike-code-scanner\zerostrike.exe
# In the container the binary is on PATH, so "zerostrike" is enough.
SCANNER_BINARY_PATH=zerostrike
# CLONE_WORKDIR_PATH=            # empty => OS temp dir/zs-clones
# Disk safety for clones. A clone is refused when the workdir volume has less than CLONE_MIN_FREE_MB
# free, and a scan fails (before the scanner runs) when the clone exceeds CLONE_MAX_REPO_MB. 0 disables
# either check. Leftover zs-clone-*/zs-remediate-* dirs older than the reap window are swept at startup
# and on every queue poll.
# CLONE_MIN_FREE_MB=1024
# CLONE_MAX_REPO_MB=2048
# Bounds the clone and the scan separately -- the real ceiling on how big a repo can be.
# SCAN_TIMEOUT_SECONDS=900
# A MEMORY bound, not a speed one (one tree-sitter parser + one file's AST per worker), and a
# no-op on scanner builds before v0.34.0. See docs/OBSERVABILITY_SCAN_AND_AI.md#large-repos.
# SCANNER_MAX_WORKERS=2
# MAX_CONCURRENT_CLOUD_SCANS=2

# GitHub/Azure DevOps OAuth repo import — register an OAuth App on each provider with callback
# URLs {BACKEND_PUBLIC_URL}/api/v1/connections/{github,azure-devops}/callback, then set:
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# AZURE_DEVOPS_CLIENT_ID=
# AZURE_DEVOPS_CLIENT_SECRET=
# OAUTH_ENCRYPTION_KEY=          # Fernet key (python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"); dev has a fixed default
# BACKEND_PUBLIC_URL=http://localhost:8000
# FRONTEND_ORIGIN=http://localhost:3000

# SMTP (email_service) — used by the forgot-password flow (and any notification emails) to send
# mail. Left empty, sending is a no-op (logs a warning) so local/dev doesn't need a real mail
# server. Provider: Brevo (https://www.brevo.com) — a plain SMTP relay, so no code
# changes are needed, just the login + SMTP key from Brevo > SMTP & API > SMTP.
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_USE_TLS=true
# SMTP_FROM_ADDRESS=noreply@zerostrike.dev   # must be a sender/domain authenticated in Brevo

# Reverse proxies in front that append to X-Forwarded-For (0 = use socket peer, ignore header).
# TRUSTED_PROXY_HOPS=0

# Reverse proxies in front that append to X-Forwarded-For (0 = use socket peer, ignore header).
# The backend Dockerfile sets 1 (Azure Container Apps ingress); use 2 if Front Door or
# Application Gateway sits in front of ACA.
# TRUSTED_PROXY_HOPS=0

# Azure Key Vault holding AI provider API keys (empty = keys stay Fernet-encrypted in Mongo).
# Auth is DefaultAzureCredential: managed identity in Azure, `az login` locally.
AZURE_KEY_VAULT_URL=
