<html>
<head>
<style>
  @page { size: A4 landscape; margin: 1.5cm 1.2cm; }
  body { font-family: Helvetica, sans-serif; font-size: 8.5pt; color: #1a1a1a; }
  h1 { font-size: 18pt; color: #7a1622; margin-bottom: 0; }
  .subtitle { color: #555; font-size: 10pt; margin-top: 2px; }
  .wrap { -pdf-word-wrap: CJK; }
  .note { background: #fdf3cd; border: 1px solid #e2c56a; padding: 6px 10px; margin-top: 10px; font-size: 8.5pt; }
  .risk-table { width: 100%; margin-top: 10px; }
  .risk-table th, .risk-table td { border: 1px solid #ddd; padding: 3px 5px; text-align: left; font-size: 8pt; vertical-align: top; }
  .risk-table th { background: #f2f2f2; }
  .sev { font-weight: bold; }
  .sev-critical { color: #7a1622; }
  .sev-high { color: #c0392b; }
  .sev-medium { color: #b9770e; }
  .sev-low { color: #2e86c1; }
  .footer { color: #999; font-size: 7.5pt; margin-top: 18px; border-top: 1px solid #eee; padding-top: 6px; }
  .empty { color: #666; font-style: italic; margin-top: 10px; }
</style>
</head>
<body>

<h1>Accepted risk report</h1>
<div class="subtitle">{{ project_name }} &middot; {{ total }} accepted risk{{ "" if total == 1 else "s" }} &middot; {{ generated_at }}</div>

<div class="note">Each finding below was accepted as a risk: it no longer fails the CI gate for the file shown. Acknowledging this report confirms that the project owner has seen these decisions and their justifications.</div>

{% if truncated %}<div class="note">Showing the first {{ rows|length }} of {{ total }}. The CSV lists all of them.</div>{% endif %}

{% if rows %}
<table class="risk-table">
  <tr>
    <th width="7%">Severity</th><th width="15%">Rule</th><th width="17%">File</th>
    <th width="12%">Requested by</th><th width="12%">Accepted by</th><th width="37%">Justification</th>
  </tr>
  {% for r in rows %}
  <tr>
    <td><span class="sev sev-{{ r.severity }}">{{ r.severity }}</span></td>
    <td class="wrap">{{ r.rule }}</td>
    <td class="wrap">{{ r.file }}</td>
    <td class="wrap">{{ r.requested_by }}<br/>{{ r.requested_at }}</td>
    <td class="wrap">{{ r.accepted_by }}<br/>{{ r.accepted_at }}{% if r.auto %}<br/>(auto-accepted){% endif %}</td>
    <td class="wrap">{{ r.comment }}</td>
  </tr>
  {% endfor %}
</table>
{% else %}
<div class="empty">No accepted risks.</div>
{% endif %}

<div class="footer">Generated by thinkShield Portal. Confidential: contains project security decisions.</div>
</body>
</html>
