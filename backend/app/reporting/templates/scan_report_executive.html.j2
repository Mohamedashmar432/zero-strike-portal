<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<style>
/* xhtml2pdf subset: solid colours only, no flex/grid/rgba/gradients, and a div's
   border/background is copied onto each child block — so cards are tables. */
@page { size: A4; margin: 1.6cm 1.5cm; }
body { font-family: Helvetica, sans-serif; font-size: 10pt; color: #1a1a2e; }
.wrap { -pdf-word-wrap: CJK; }

.cover { width: 100%; background: #0d1b2a; color: #ffffff; }
.cover td { vertical-align: top; }
.cover td.cover-body { padding-top: 36px; padding-bottom: 32px; }
.cover-eyebrow { font-size: 8pt; letter-spacing: 2px; text-transform: uppercase; color: #7ec8e3; }
.cover-title { font-size: 32pt; font-weight: bold; color: #ffffff; line-height: 1.1; margin-top: 10px; }
.cover-subtitle { font-size: 12pt; color: #a8dadc; margin-top: 6px; margin-bottom: 26px; }
.cover-meta { width: 100%; margin-bottom: 16px; }
.cover-meta td { padding: 0 16px 14px 0; vertical-align: top; color: #ffffff; }
.meta-label { font-size: 7.5pt; text-transform: uppercase; letter-spacing: 1px; color: #7ec8e3; }
.meta-value { font-size: 11pt; font-weight: bold; color: #ffffff; margin-top: 3px; }
.scanner-pill { font-size: 9pt; color: #ffffff; }
.cover-stats { width: 100%; margin-top: 18px; margin-bottom: 20px; }
.cover-stats td { background: #1b2838; border: 1px solid #2c3e55; padding: 10px 4px; text-align: center; }
.stat-num { font-size: 20pt; font-weight: bold; }
.stat-lbl { font-size: 7pt; text-transform: uppercase; letter-spacing: 1px; color: #a8dadc; margin-top: 2px; }
.risk-banner { padding: 10px 16px; font-weight: bold; font-size: 12pt; }
.risk-CRITICAL { background: #e63946; color: #ffffff; }
.risk-HIGH     { background: #f4a261; color: #1a1a2e; }
.risk-MEDIUM   { background: #e9c46a; color: #1a1a2e; }
.risk-LOW      { background: #2a9d8f; color: #ffffff; }
.risk-NONE     { background: #2a9d8f; color: #ffffff; }

.page-break { page-break-before: always; }
h2 { font-size: 15pt; font-weight: bold; color: #0f3460; border-bottom: 2px solid #e63946; padding-bottom: 5px; margin-top: 22px; margin-bottom: 10px; }
p  { line-height: 1.5; margin-bottom: 8px; color: #333333; }

.summary-grid { width: 100%; margin-bottom: 16px; }
.summary-grid td { padding: 10px 4px; text-align: center; border: 2px solid #ffffff; }
.summary-count { font-size: 20pt; font-weight: bold; }
.summary-label { font-size: 7.5pt; text-transform: uppercase; letter-spacing: 1px; margin-top: 2px; }
.card-critical { background: #fde8ea; color: #e63946; }
.card-high     { background: #fdf0e4; color: #e76f51; }
.card-medium   { background: #fdf8e4; color: #c98a10; }
.card-low      { background: #e4f5f3; color: #2a9d8f; }
.card-info     { background: #eef2ff; color: #6366f1; }

table.data { width: 100%; margin-bottom: 14px; font-size: 9pt; }
table.data th { background: #0f3460; color: #ffffff; padding: 6px 8px; text-align: left; font-weight: bold; }
table.data td { padding: 5px 8px; border-bottom: 1px solid #e8e8e8; vertical-align: top; }

.badge { font-size: 8pt; font-weight: bold; }
.badge-CRITICAL { background: #fde8ea; color: #e63946; }
.badge-HIGH     { background: #fdf0e4; color: #e76f51; }
.badge-MEDIUM   { background: #fdf8e4; color: #c98a10; }
.badge-LOW      { background: #e4f5f3; color: #2a9d8f; }
.badge-INFO     { background: #eef2ff; color: #6366f1; }
.pass { color: #2a9d8f; font-weight: bold; }
.fail { color: #e63946; font-weight: bold; }

.finding-head { width: 100%; margin-top: 14px; }
.finding-head td { background: #f4f6fb; padding: 6px 8px; border-top: 2px solid #0f3460; vertical-align: middle; }
.finding-title { font-weight: bold; font-size: 11pt; color: #1a1a2e; }
.finding-meta { font-size: 8.5pt; color: #666666; margin-top: 4px; }
.finding-meta b { color: #1a1a2e; }
.finding-loc { font-family: Courier, monospace; font-size: 8pt; background: #f0f4ff; color: #2c3e6b; padding: 3px 6px; margin-top: 4px; }
.finding-msg { font-size: 9.5pt; margin-top: 5px; margin-bottom: 0; }
pre.code-block { background: #0d1b2a; color: #e2e8f0; font-family: Courier, monospace; font-size: 8pt; padding: 6px 8px; margin-top: 5px; }
.rec { background: #f0f7ff; border-left: 3px solid #0f3460; padding: 6px 10px; font-size: 9pt; color: #333333; margin-top: 5px; }

.conclusion { width: 100%; margin-top: 22px; }
.conclusion td { background: #1a1a2e; color: #a8dadc; padding: 16px 20px; font-size: 9pt; line-height: 1.5; }
</style>
</head>
<body>

<table class="cover"><tr><td width="6%"></td><td class="cover-body" width="88%">
  <div class="cover-eyebrow">thinkShield Security Assessment Report</div>
  <div class="cover-title">Security Assessment</div>
  <div class="cover-subtitle">Static Application Security Testing</div>

  <table class="cover-meta">
    <tr>
      <td width="50%"><div class="meta-label">Project</div><div class="meta-value wrap">{{ project_name }}</div></td>
      <td width="50%"><div class="meta-label">Repository</div><div class="meta-value wrap">{{ scan.repo_url or report.root_path or "—" }}</div></td>
    </tr>
    <tr>
      <td><div class="meta-label">Branch</div><div class="meta-value wrap">{{ report.branch or scan.branch or "—" }}</div></td>
      <td><div class="meta-label">Scan Date</div><div class="meta-value">{{ report.started_at.strftime('%Y-%m-%d') if report.started_at else "—" }}</div></td>
    </tr>
    <tr>
      <td><div class="meta-label">AI Provider</div><div class="meta-value">Not tracked</div></td>
      <td><div class="meta-label">Scan ID</div><div class="meta-value">{{ (scan.id | string)[:8] }}</div></td>
    </tr>
  </table>

  <div class="meta-label">Scanners Executed</div>
  <div class="scanner-pill">{{ scanners_used | join("  ·  ") if scanners_used else "—" }}</div>

  <table class="cover-stats">
    <tr>
      <td><div class="stat-num" style="color:#ffffff;">{{ total_findings }}</div><div class="stat-lbl">Total</div></td>
      <td><div class="stat-num" style="color:#ff4d6d;">{{ report.stats.by_severity.get('critical', 0) }}</div><div class="stat-lbl">Critical</div></td>
      <td><div class="stat-num" style="color:#ff9a3c;">{{ report.stats.by_severity.get('high', 0) }}</div><div class="stat-lbl">High</div></td>
      <td><div class="stat-num" style="color:#ffd166;">{{ report.stats.by_severity.get('medium', 0) }}</div><div class="stat-lbl">Medium</div></td>
      <td><div class="stat-num" style="color:#06d6a0;">{{ report.stats.by_severity.get('low', 0) }}</div><div class="stat-lbl">Low</div></td>
      <td><div class="stat-num" style="color:#8ab4ff;">{{ report.stats.by_severity.get('info', 0) }}</div><div class="stat-lbl">Info</div></td>
    </tr>
  </table>

  <div class="risk-banner risk-{{ overall_risk }}">Overall Risk: {{ overall_risk }}</div>
</td><td width="6%"></td></tr></table>

<div class="page-break"></div>

<h2>1. Executive Summary</h2>
<p>{{ executive_summary }}</p>

<table class="summary-grid">
  <tr>
    <td class="card-critical"><div class="summary-count">{{ report.stats.by_severity.get('critical', 0) }}</div><div class="summary-label">Critical</div></td>
    <td class="card-high"><div class="summary-count">{{ report.stats.by_severity.get('high', 0) }}</div><div class="summary-label">High</div></td>
    <td class="card-medium"><div class="summary-count">{{ report.stats.by_severity.get('medium', 0) }}</div><div class="summary-label">Medium</div></td>
    <td class="card-low"><div class="summary-count">{{ report.stats.by_severity.get('low', 0) }}</div><div class="summary-label">Low</div></td>
    <td class="card-info"><div class="summary-count">{{ report.stats.by_severity.get('info', 0) }}</div><div class="summary-label">Info</div></td>
  </tr>
</table>

<h2>2. Technology Stack</h2>
<p>Technology stack detection was not performed.</p>

<h2>3. Findings by Kind</h2>
<table class="data">
  <tr><th width="70%">Kind</th><th width="30%">Findings</th></tr>
  {% for kind, label in [('sast','Static Analysis (SAST)'), ('secret','Secrets'), ('sca','Dependencies (SCA)'), ('config','Configuration')] %}
  {% if report.stats.by_kind.get(kind) %}
  <tr><td><b>{{ label }}</b></td><td>{{ report.stats.by_kind.get(kind) }}</td></tr>
  {% endif %}
  {% endfor %}
</table>

<div class="page-break"></div>

<h2>4. OWASP Top 10 Compliance</h2>

{% set ns = namespace(total_fail=0) %}
<table class="data">
  <tr><th width="48%">Category</th><th width="14%">Code</th><th width="11%">Status</th><th width="11%">Findings</th><th width="16%">Max Severity</th></tr>
{% for code, name in owasp_all %}
  {% set cat_findings = [] %}
  {% for f in findings %}
    {% if f.owasp and code in f.owasp %}
      {% set _ = cat_findings.append(f) %}
    {% endif %}
  {% endfor %}
  {% set fail = cat_findings | length > 0 %}
  {% if fail %}{% set ns.total_fail = ns.total_fail + 1 %}{% endif %}
  {% set sevs = cat_findings | map(attribute='severity') | list %}
  {% set top = 'CRITICAL' if 'critical' in sevs else 'HIGH' if 'high' in sevs else 'MEDIUM' if 'medium' in sevs else 'LOW' %}
  <tr>
    <td><b>{{ name }}</b></td>
    <td>{{ code }}</td>
    <td>{% if fail %}<span class="fail">FAIL</span>{% else %}<span class="pass">PASS</span>{% endif %}</td>
    <td>{{ cat_findings | length }}</td>
    <td>{% if fail %}<span class="badge badge-{{ top }}">&nbsp;{{ top }}&nbsp;</span>{% else %}—{% endif %}</td>
  </tr>
{% endfor %}
</table>

<p>
  <b>OWASP Summary:</b>
  {{ ns.total_fail }} of 10 categories have findings.
  {% if ns.total_fail == 0 %}No OWASP Top 10 violations detected.
  {% elif ns.total_fail <= 3 %}Low OWASP exposure — address findings by priority.
  {% elif ns.total_fail <= 6 %}Moderate OWASP exposure — security review recommended.
  {% else %}High OWASP exposure — security remediation required before release.{% endif %}
</p>

<div class="page-break"></div>

{% set section_num = namespace(n=5) %}
{% for severity in ['critical', 'high', 'medium', 'low', 'info'] %}
{% set sev_findings = findings | selectattr('severity', 'eq', severity) | list %}
{% if sev_findings %}
<h2>{{ section_num.n }}. {{ severity | title }} Findings ({{ sev_findings | length }})</h2>
{% set section_num.n = section_num.n + 1 %}
{% for f in sev_findings %}
<table class="finding-head"><tr>
  <td width="84%"><span class="finding-title">{{ f.rule_name or f.rule_id or "Untitled finding" }}</span></td>
  <td width="16%" align="right"><span class="badge badge-{{ f.severity | upper }}">&nbsp;{{ f.severity | upper }}&nbsp;</span></td>
</tr></table>
<div class="finding-meta">
  Kind: <b>{{ f.kind or "—" }}</b> &nbsp;&middot;&nbsp; Priority: <b>{{ f.priority_score if f.priority_score is not none else "—" }}/10</b>
  {% if f.cwe %} &nbsp;&middot;&nbsp; CWE: <b>{{ f.cwe | join(", ") }}</b>{% endif %}
  {% if f.owasp %} &nbsp;&middot;&nbsp; OWASP: <b>{{ f.owasp | join(", ") }}</b>{% endif %}
</div>
{% if f.location.file %}
<div class="finding-loc wrap">{{ f.location.file }}{% if f.location.start_line %}:{{ f.location.start_line }}{% endif %}</div>
{% endif %}
<p class="finding-msg">{{ f.message }}</p>
{% if f.evidence and f.evidence[0].snippet %}
<pre class="code-block wrap">{{ f.evidence[0].snippet | dedent }}</pre>
{% endif %}
{% if f.remediation %}<div class="rec"><b>Recommendation:</b> {{ f.remediation }}</div>{% endif %}
{% endfor %}
{% endif %}
{% endfor %}

{% set secret_findings = findings | selectattr('kind', 'eq', 'secret') | list %}
<h2>{{ section_num.n }}. Secrets &amp; Sensitive Data Exposure</h2>
{% set section_num.n = section_num.n + 1 %}
{% if secret_findings %}
<p style="color:#e63946;font-weight:bold;">{{ secret_findings | length }} secret(s) / sensitive value(s) detected. Rotate all exposed credentials immediately.</p>
<table class="data">
  <tr><th width="30%">Rule</th><th width="44%">File</th><th width="10%">Line</th><th width="16%">Severity</th></tr>
  {% for f in secret_findings %}
  <tr>
    <td>{{ f.rule_name or f.rule_id or "—" }}</td>
    <td class="wrap" style="font-family:Courier,monospace;font-size:8pt;">{{ f.location.file }}</td>
    <td>{{ f.location.start_line or "N/A" }}</td>
    <td><span class="badge badge-{{ f.severity | upper }}">&nbsp;{{ f.severity | upper }}&nbsp;</span></td>
  </tr>
  {% endfor %}
</table>
{% else %}
<p style="color:#2a9d8f;">No hardcoded secrets or credentials detected.</p>
{% endif %}

{% set dep_findings = findings | selectattr('kind', 'eq', 'sca') | list %}
<h2>{{ section_num.n }}. Dependency Risks</h2>
{% set section_num.n = section_num.n + 1 %}
{% if dep_findings %}
<table class="data">
  <tr><th width="40%">Vulnerability</th><th width="16%">Severity</th><th width="44%">Manifest File</th></tr>
  {% for f in dep_findings %}
  <tr>
    <td>{{ f.rule_name or f.rule_id or "—" }}</td>
    <td><span class="badge badge-{{ f.severity | upper }}">&nbsp;{{ f.severity | upper }}&nbsp;</span></td>
    <td class="wrap" style="font-family:Courier,monospace;font-size:8pt;">{{ f.dependency.manifest if f.dependency else f.location.file }}</td>
  </tr>
  {% endfor %}
</table>
{% else %}
<p style="color:#2a9d8f;">No known vulnerable dependencies detected.</p>
{% endif %}

{% if cwe_summary %}
<h2>{{ section_num.n }}. CWE Mapping</h2>
{% set section_num.n = section_num.n + 1 %}
<table class="data">
  <tr><th width="40%">CWE</th><th width="30%">Count</th><th width="30%">Max Severity</th></tr>
  {% for row in cwe_summary %}
  <tr>
    <td><b>{{ row.cwe }}</b></td>
    <td>{{ row.count }}</td>
    <td><span class="badge badge-{{ row.max_severity | upper }}">&nbsp;{{ row.max_severity | upper }}&nbsp;</span></td>
  </tr>
  {% endfor %}
</table>
{% endif %}

<h2>{{ section_num.n }}. Remediation Plan</h2>
{% set rem_findings = remediation_findings %}
{% if rem_findings %}
<p>Findings are ordered by priority score (highest first).</p>
<table class="data">
  <tr><th width="6%">#</th><th width="30%">Finding</th><th width="12%">Priority</th><th width="14%">OWASP</th><th width="38%">Action</th></tr>
  {% for f in rem_findings %}
  <tr>
    <td>{{ loop.index }}</td>
    <td>{{ (f.rule_name or f.rule_id or "Untitled finding") | truncate(55) }}</td>
    <td><b>{{ f.priority_score if f.priority_score is not none else "—" }}/10</b></td>
    <td style="font-size:8pt;">{{ (f.owasp | join(", ")) | truncate(20) if f.owasp else "—" }}</td>
    <td style="font-size:8pt;">{{ (f.remediation or "—") | truncate(100) }}</td>
  </tr>
  {% endfor %}
</table>
{% else %}
<p>No remediation actions required.</p>
{% endif %}

<table class="conclusion"><tr><td>
  This report was generated by the thinkShield Portal's SAST scan engine. All findings should be reviewed by a qualified security engineer before remediation. This report reflects a point-in-time snapshot and does not replace a full manual penetration test.
  <br/><br/>
  <span style="font-size:8pt;color:#8a99ad;">Scan ID: {{ scan.id }} &nbsp;|&nbsp; Generated: {{ report.generated_at.strftime('%Y-%m-%d %H:%M UTC') if report.generated_at else "—" }}</span>
</td></tr></table>

</body>
</html>
