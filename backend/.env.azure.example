# Backend Container App — env vars for Azure Container Apps (not used by local dev,
# see .env.example for that). Secrets (MONGODB_URI, JWT_SECRET, SMTP_PASSWORD) are supplied
# as ACA *secrets* and referenced with secretref:<name>; never put real values in this file.
# Plain env vars for the rest.

MONGODB_URI=secretref:mongodb-uri   # value shape: mongodb+srv://<user>:<password>@<cluster>/?retryWrites=true&w=majority
MONGODB_DB_NAME=zerostrike
JWT_SECRET=secretref:jwt-secret     # generate a long random secret
CORS_ORIGINS=["https://zero-strike-frontend.<region>.azurecontainerapps.io"]

# Required: public URL of the frontend, used for the links in password-reset and welcome emails.
FRONTEND_ORIGIN=https://zero-strike-frontend.<region>.azurecontainerapps.io

# Scan execution — these match the Dockerfile/compose defaults, only override if needed.
SCANNER_BINARY_PATH=zerostrike
CLONE_WORKDIR_PATH=/tmp/zs-clones
SCAN_TIMEOUT_SECONDS=900
MAX_CONCURRENT_CLOUD_SCANS=2

# No PORT here — ACA ingress targetPort=8000 handles this, uvicorn already
# defaults to 8000 via `${PORT:-8000}` in backend/Dockerfile.

# Optional: GitHub/Azure DevOps repo import OAuth (omit entirely if not using this feature)
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# AZURE_DEVOPS_CLIENT_ID=
# AZURE_DEVOPS_CLIENT_SECRET=
# OAUTH_ENCRYPTION_KEY=
# BACKEND_PUBLIC_URL=https://zero-strike-backend.<region>.azurecontainerapps.io

# Optional: SMTP for forgot-password/notification emails (omit = no-op, logs a warning).
# SMTP_USERNAME and SMTP_FROM_ADDRESS are the only names the app reads for the login user and
# sender (no SMTP_USER / SMTP_FROM). SMTP_PASSWORD comes from a secret: SMTP_PASSWORD=secretref:smtp-password
# Provider: SMTP2GO — a plain SMTP relay, credentials from its dashboard (Settings > SMTP Users).
# SMTP_HOST=mail.smtp2go.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=secretref:smtp-password
# SMTP_USE_TLS=true
# SMTP_FROM_ADDRESS=noreply@zerostrike.dev   # must be a sender/domain verified in SMTP2GO

# Azure Key Vault holding AI provider API keys (empty = keys stay Fernet-encrypted in Mongo).
# Auth is DefaultAzureCredential: managed identity in Azure, `az login` locally.
AZURE_KEY_VAULT_URL=
