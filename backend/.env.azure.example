# Backend Container App — env vars for Azure Container Apps (not used by local dev,
# see .env.example for that). Set MONGODB_URI and JWT_SECRET as ACA *secrets* and
# reference them (secretRef), plain env vars for the rest.

MONGODB_URI=mongodb+srv://zerostrike:changeme@zerostrike.hufbofu.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=zerostrike
JWT_SECRET=changeme-generate-a-real-random-secret
CORS_ORIGINS=["https://zero-strike-frontend.<region>.azurecontainerapps.io"]

# Scan execution — these match the Dockerfile/compose defaults, only override if needed.
SCANNER_BINARY_PATH=zerostrike
CLONE_WORKDIR_PATH=/tmp/zs-clones
SCAN_TIMEOUT_SECONDS=900
MAX_CONCURRENT_CLOUD_SCANS=2

# No PORT here — ACA ingress targetPort=8000 handles this, uvicorn already
# defaults to 8000 via `${PORT:-8000}` in backend/Dockerfile.

# Optional: GitHub/Azure DevOps repo import OAuth (omit entirely if not using this feature)
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# AZURE_DEVOPS_CLIENT_ID=
# AZURE_DEVOPS_CLIENT_SECRET=
# OAUTH_ENCRYPTION_KEY=
# BACKEND_PUBLIC_URL=https://zero-strike-backend.<region>.azurecontainerapps.io
# FRONTEND_ORIGIN=https://zero-strike-frontend.<region>.azurecontainerapps.io

# Optional: SMTP for forgot-password emails (omit = no-op, logs a warning)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_USE_TLS=true
# SMTP_FROM_ADDRESS=noreply@zerostrike.dev
